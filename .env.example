# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/access_marketplace"

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# From your Paystack dashboard (use the TEST key while developing)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Public URL of this app, used to build Paystack's callback_url
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret your external cron scheduler sends as `x-cron-secret`
# when hitting /api/cron/release-payouts
CRON_SECRET=""

# The-mighty-admin console (/admin-login). This is a SEPARATE login system
# from regular user accounts — providers and renters cannot reach it even
# if they know a URL, because it doesn't check the User table at all, it
# checks these two values. Change them before you deploy for real.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password"

# Resend (https://resend.com) — used to email the admin whenever someone
# tops up their wallet or requests a withdrawal, since money movement is
# handled manually for now. Get an API key from your Resend dashboard.
RESEND_API_KEY=""
# Must be an address on a domain you've verified with Resend. Until you
# verify a domain, emails will only deliver to the Resend account owner's
# own inbox — fine for testing, not for real notifications.
EMAIL_FROM="Access Marketplace <onboarding@resend.dev>"
# Where top-up / withdrawal alerts are sent.
ADMIN_NOTIFICATION_EMAIL="hnrkane0@gmail.com"

# Paystack plan codes for the three signup packages (from your Paystack
# dashboard → Payments → Plans). Starter has a 7-day trial before its
# first real charge; Eternal and Pro charge immediately.
PAYSTACK_PLAN_STARTER="PLN_4fj6ah6f5oo2tlx"
PAYSTACK_PLAN_ETERNAL="PLN_moo8asxaof1nqjl"
PAYSTACK_PLAN_PRO="PLN_w7pnequ8jp3hc5d"
