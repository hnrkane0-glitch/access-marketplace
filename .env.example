# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/access_marketplace"

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# From your Paystack dashboard (use the TEST key while developing)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Public URL of this app, used to build Paystack's callback_url
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret your external cron scheduler sends as `x-cron-secret`
# when hitting /api/cron/release-payouts
CRON_SECRET=""
